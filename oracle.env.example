# Copia a oracle.env (NO se versiona) y rellena con tus datos.
# La conexión es solo del oráculo de conformidad; nunca entra al repo iNative.

ORACLE_IBM_HOST=pub400.com
ORACLE_IBM_PORT=22
ORACLE_IBM_RELEASE=7.5
ORACLE_IBM_USER=C3S41
ORACLE_IBM_PASSWORD=*****
ORACLE_IBM_LIB=C3S411
ORACLE_IBM_CCSID=37

ORACLE_IBM_TN5250_PORT=23
ORACLE_IBM_TN5250_SSL=false

# ODBC (si usas pyodbc con un DSN configurado por el cliente IBM i Access)
# ORACLE_IBM_ODBC_DSN=
# ORACLE_IBM_ODBC_UID=
# ORACLE_IBM_ODBC_PWD=
